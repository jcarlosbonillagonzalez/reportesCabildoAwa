@model IEnumerable<ReportesCabildoAwa.Models.Persona>

@{
    ViewData["Title"] = "Listado de Personas";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Personas Registradas</h2>
        <div>
            <a asp-action="ExportarExcel" class="btn btn-outline-success me-2">📥 Exportar Excel</a>
            <a asp-action="Create" class="btn btn-primary">+ Nueva Persona</a>
        </div>
    </div>

    <div class="table-responsive d-flex justify-content-center">
        <table class="table table-hover table-bordered align-middle" style="width: 90%;">
            <thead class="table-light">
        <tr>
                    <th>@Html.DisplayNameFor(model => model.NumeroDocumento)</th>
                    <th>@Html.DisplayNameFor(model => model.Nombre)</th>
                    <th>@Html.DisplayNameFor(model => model.Apellido)</th>
                    <th>@Html.DisplayNameFor(model => model.FechaNacimiento)</th>
                    <th>@Html.DisplayNameFor(model => model.Direccion)</th>
                    <th>@Html.DisplayNameFor(model => model.Telefono)</th>
                    <th>@Html.DisplayNameFor(model => model.CorreoElectronico)</th>
                    <th>@Html.DisplayNameFor(model => model.TipoDocumento)</th>
                    <th>@Html.DisplayNameFor(model => model.EstadoPersona)</th>
                    <th class="text-center" style="min-width: 200px;">Acciones</th>
        </tr>
    </thead>
    <tbody>
                @foreach (var item in Model)
                {
        <tr>
                        <td>@item.NumeroDocumento</td>
                        <td>@item.Nombre</td>
                        <td>@item.Apellido</td>
                        <td>@item.FechaNacimiento.ToShortDateString()</td>
                        <td>@item.Direccion</td>
                        <td>@item.Telefono</td>
                        <td>@item.CorreoElectronico</td>
                        <td>@item.TipoDocumento?.Nombre</td>
                        <td class="text-center">
                            <span class="badge @(item.EstadoPersona ? "bg-success" : "bg-secondary")">
                                @(item.EstadoPersona ? "Activo" : "Inactivo")
                            </span>
            </td>
                        <td class="text-center">
                            <div class="btn-group" role="group">
                                <a asp-action="Edit" asp-route-id="@item.IdPersona" class="btn btn-sm btn-outline-warning" title="Editar">✏️</a>
                                <a asp-action="Details" asp-route-id="@item.IdPersona" class="btn btn-sm btn-outline-info" title="Detalles">🔍</a>
                                <a asp-action="Delete" asp-route-id="@item.IdPersona" class="btn btn-sm btn-outline-danger" title="Eliminar">🗑️</a>
                            </div>
            </td>
        </tr>
}
    </tbody>

</table>
    </div>
</div>
