@model ReportesCabildoAwa.Common.Paginacion.PagedResult<ReportesCabildoAwa.Models.Persona>
@using ReportesCabildoAwa.Common.Constantes

@{
    ViewData["Title"] = "Listado de Personas";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Personas Registradas</h2>
        <div>
            <a asp-action="ExportarExcel" class="btn btn-outline-success me-2">📥 Exportar Excel</a>
            <a asp-action="Create" class="btn btn-primary">+ Nueva Persona</a>
        </div>
    </div>

    <!-- Selector de cantidad por página (arriba) -->
    <form method="get" class="mb-3 d-flex justify-content-end align-items-center">
        <label for="pageSize" class="me-2 mb-0">Registros por página:</label>
        <select id="pageSize" name="pageSize" class="form-select w-auto" onchange="this.form.submit()">
            @foreach (var size in PaginacionConstantes.TamañosPermitidos)
            {
                var selected = Model.PageSize == size ? "selected=\"selected\"" : "";
                @:<option value="@size" @Html.Raw(selected)>@size</option>
            }
        </select>
        <input type="hidden" name="page" value="1" />
    </form>

    <!-- Tabla de personas -->
    <div class="table-responsive">
        <table class="table table-hover table-bordered align-middle w-100">
            <thead class="table-light">
                <tr>
                    <th>Documento</th>
                    <th>Nombre</th>
                    <th>Apellido</th>
                    <th>Fecha Nacimiento</th>
                    <th>Dirección</th>
                    <th>Teléfono</th>
                    <th>Correo</th>
                    <th>Tipo Doc.</th>
                    <th>Estado</th>
                    <th class="text-center" style="min-width: 200px;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.NumeroDocumento</td>
                        <td>@item.Nombre</td>
                        <td>@item.Apellido</td>
                        <td>@item.FechaNacimiento.ToShortDateString()</td>
                        <td>@item.Direccion</td>
                        <td>@item.Telefono</td>
                        <td>@item.CorreoElectronico</td>
                        <td>@item.TipoDocumento?.Nombre</td>
                        <td class="text-center">
                            <span class="badge @(item.EstadoPersona ? "bg-success" : "bg-secondary")">
                                @(item.EstadoPersona ? "Activo" : "Inactivo")
                            </span>
                        </td>
                        <td class="text-center">
                            <div class="btn-group" role="group">
                                <a asp-action="Edit" asp-route-id="@item.IdPersona" class="btn btn-sm btn-outline-warning" title="Editar">✏️</a>
                                <a asp-action="Details" asp-route-id="@item.IdPersona" class="btn btn-sm btn-outline-info" title="Detalles">🔍</a>
                                <a asp-action="Delete" asp-route-id="@item.IdPersona" class="btn btn-sm btn-outline-danger" title="Eliminar">🗑️</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Navegación de páginas + Selector -->
    <div class="d-flex justify-content-between align-items-center mt-4">
        <nav>
            <ul class="pagination mb-0">
                <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                    <a class="page-link" asp-action="Index"
                       asp-route-page="@(Model.PageNumber - 1)"
                       asp-route-pageSize="@Model.PageSize">Anterior</a>
                </li>

                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-page="@i"
                           asp-route-pageSize="@Model.PageSize">@i</a>
                    </li>
                }

                <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                    <a class="page-link" asp-action="Index"
                       asp-route-page="@(Model.PageNumber + 1)"
                       asp-route-pageSize="@Model.PageSize">Siguiente</a>
                </li>
            </ul>
        </nav>

        <!-- Selector de cantidad por página (abajo) -->
        <form method="get" class="d-flex align-items-center ms-3">
            <label for="pageSizeBottom" class="me-2 mb-0">Registros por página:</label>
            <select id="pageSizeBottom" name="pageSize" class="form-select w-auto" onchange="this.form.submit()">
                @foreach (var size in PaginacionConstantes.TamañosPermitidos)
                {
                    var selected = Model.PageSize == size ? "selected=\"selected\"" : "";
                    @:<option value="@size" @Html.Raw(selected)>@size</option>
                }
            </select>
            <input type="hidden" name="page" value="1" />
        </form>
    </div>
</div>
